# Copy to ~/.config/today/.env and fill in. That file is git-ignored; this one is not.
# Everything here is optional — the app runs without it.
#
# Nothing in this file is a secret. App passwords live in the macOS Keychain
# (see "Mail accounts" in the window, or `today mail add`), never here.

# Addresses offered as one-click fills on the Mail accounts page, comma separated.
TODAY_ACCOUNT_HINTS=you@gmail.com,you@university.edu

# Parts of your own name, as they turn up at the end of a mail subject:
#   "TRN Application Status - Data Scientist Intern - Ada Lovelace"
# The role extractor stops at your name instead of reading it as part of the role.
TODAY_NAME_TOKENS=ada,lovelace
