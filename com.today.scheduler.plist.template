<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. install-login-item.sh substitutes __APP_DIR__ and writes the result to
     ~/Library/LaunchAgents/com.today.scheduler.plist, so no absolute home path is committed. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.today.scheduler</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/osascript</string>
		<string>__APP_DIR__/open-at-login.applescript</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/today-login.err</string>
</dict>
</plist>
